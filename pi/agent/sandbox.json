{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowedDomains": [
      "*.github.com",
      "*.npmjs.org",
      "*.pypi.org",
      "*.pythonhosted.org",
      "api.github.com",
      "github.com",
      "npmjs.org",
      "pypi.org",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": ["/home"],
    "allowRead": [
      "/home/simon/.claude",
      "/home/simon/.config",
      "/home/simon/.dotfiles",
      "/home/simon/dev",
      "/home/simon/notes",
      "/home/simon/nixos-config"
    ],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "id_rsa",
      "id_ed25519",
      "*.sops.yaml",
      "*.sops.json"
    ]
  }
}
